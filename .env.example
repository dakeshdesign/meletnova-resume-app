# Server Environment Configuration Template
PORT=3000
NODE_ENV=development

# Razorpay API Credentials (Get from https://dashboard.razorpay.com -> Settings -> API Keys)
# For Test Mode: starts with 'rzp_test_'
# For Live Mode: starts with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Settings -> Webhooks)
# Required to verify X-Razorpay-Signature on incoming webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# PhonePe Credentials (Optional)
PHONEPE_CLIENT_ID=your_phonepe_client_id_here
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret_here
PHONEPE_CLIENT_VERSION=v1
PHONEPE_ENV=TEST

